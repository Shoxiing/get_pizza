TELEGRAM_BOT_API_KEY=
# нужен для скачивания моделей с Hugging Face (и для HF router, если LLM не локальная)
HF_TOKEN=

# Модель для vLLM (docker-compose) и для бота
LLM_MODEL=Qwen/Qwen3-14B-AWQ

# Вариант без локального GPU под LLM — HF Inference Providers (OpenAI-совместимый API):
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_API_KEY=hf_...
# LLM_MODEL=Qwen/Qwen3-14B
# LLM_STRICT_CATALOG=false   # не все провайдеры тянут enum на 466 значений
